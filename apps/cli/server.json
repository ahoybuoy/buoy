{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.json",
  "name": "io.github.ahoybuoy/buoy",
  "description": "Design tokens and drift checks for coding agents: stop hardcoding values that already have a token.",
  "repository": { "url": "https://github.com/ahoybuoy/buoy", "source": "github" },
  "version": "0.7.3",
  "packages": [
    {
      "registry_type": "npm",
      "identifier": "@buoy-design/cli",
      "version": "0.7.3",
      "transport": { "type": "stdio" },
      "package_arguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "positional", "value": "serve" }
      ]
    }
  ]
}
