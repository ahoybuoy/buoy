{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ahoybuoy/buoy",
  "description": "The design system your coding agents check before they ship: tokens plus exact UI fixes.",
  "repository": {
    "url": "https://github.com/ahoybuoy/buoy",
    "source": "github"
  },
  "version": "0.8.11",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@buoy-design/cli",
      "version": "0.8.11",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
